{
  "name": "docker-sandbox-box-contract-review",
  "version": "1.0.0",
  "description": "Box Mount contract review demo for Docker Sandboxes and Box",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx src/setup.ts",
    "doctor": "tsx src/doctor.ts",
    "seed": "tsx src/seed.ts",
    "demo": "tsx src/demo.ts",
    "status": "tsx src/status.ts",
    "teardown": "tsx src/teardown.ts",
    "check:ubuntu": "bash scripts/check-ubuntu.sh",
    "generate:fixtures": "tsx scripts/generate-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test tests/*.test.ts"
  },
  "keywords": [
    "box",
    "ai-agents"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "box-node-sdk": "^10.14.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "docx": "^9.7.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
