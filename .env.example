# Store with: echo "$BOX_ACCESS_TOKEN" | sbx secret set box
BOX_ACCESS_TOKEN=
BOX_FOLDER_ID=

# Optional: assign a Box review task on the generated file
BOX_REVIEWER_USER_ID=

# Required: also register this key with `sbx secret set openai`
OPENAI_API_KEY=
# Optional model override
OPENAI_MODEL=gpt-5.5
